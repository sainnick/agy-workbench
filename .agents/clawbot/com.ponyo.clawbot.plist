<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 微信 ClawBot 桥：开机自启 + 崩溃自动重启（2026-11-06 审计 P2）。与 com.eru.* 代理服务无关 -->
  <key>Label</key>
  <string>com.ponyo.clawbot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/eru/Desktop/agy工作站/.agents/clawbot/bridge.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/eru/Desktop/agy工作站/.agents/clawbot</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/eru</string>
    <key>LANG</key>
    <string>zh_CN.UTF-8</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/Users/eru/Desktop/agy工作站/.agents/clawbot/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/eru/Desktop/agy工作站/.agents/clawbot/bridge.log</string>
</dict>
</plist>
